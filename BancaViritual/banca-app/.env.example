# Copia este archivo a .env y rellena los valores. NO subas .env al repo.

# Públicas (van al navegador). La anon key es pública por diseño (protegida por RLS).
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key"

# Secreto de servidor: SOLO para Prisma (migraciones/seed). Nunca llega al navegador.
# Supabase Dashboard → Settings → Database → Connection string (pestaña ORM/Prisma).
DATABASE_URL="postgresql://postgres.TU-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
